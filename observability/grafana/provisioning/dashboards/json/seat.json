{
  "uid": "seat-redesign",
  "title": "Seat Redesign Measurement",
  "schemaVersion": 41,
  "version": 1,
  "refresh": "5s",
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Host CPU user/system/iowait",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(mode)(rate(node_cpu_seconds_total{mode=~\"user|system|iowait\"}[1m]))",
          "legendFormat": "{{instance}} {{mode}} {{command}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "%"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "title": "Host memory used",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemTotal_bytes-node_memory_MemAvailable_bytes",
          "legendFormat": "{{instance}} {{mode}} {{command}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
