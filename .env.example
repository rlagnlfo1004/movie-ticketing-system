# python3 infra/stages/ensure-local-env.py 가 실제 값을 .env에 만든다.
SEAT_DB_NAME=movie_seats
SEAT_DB_USER=movie
SEAT_DB_PASSWORD=
SEAT_DB_ROOT_PASSWORD=
MOCK_PG_API_SECRET=
MOCK_PG_WEBHOOK_SECRET=
RESERVATION_MOCK_PG_API_SECRET=
RESERVATION_WEBHOOK_SECRET=
RESERVATION_RECONCILIATION_KEY=
GRAFANA_ADMIN_PASSWORD=
MOCK_PG_STORE_ID=store-mock

# 단계 파일에서 지정한다. 가상 스레드 기준선은 켬(true), 비교 실행에서만 false.
SPRING_THREADS_VIRTUAL_ENABLED=true
HOLD_DURATION=30s
PAYMENT_MODE=mock
ACTIVE_CHECK_MODE=lua
REDIS_CONFIG=./infra/tuning/redis-v6.conf
REDIS_APPENDONLY=yes
REDIS_APPENDFSYNC=everysec

# 로컬 스모크·측정 실행 선택값. 비워 두면 스크립트 기본값을 쓴다.
STAGE=v6-aof-reconcile
STAGE_PROFILE=v6
RUN_ID=
SCENARIO=A
SCREENING_ID=1
STAGE_SECONDS=60
SMOKE=0
V1_LOCK_PAUSE=0ms
WORKER_TEST_WRITE_PAUSE=0ms
WORKER_RECLAIM_MIN_IDLE=30s
